# Copy this file to .env and fill in your key(s). .env is git-ignored.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Only needed if you want to demonstrate LiteLLM fallback/routing
# across providers (see llm.py + README "Demonstrating provider fallback").
# ANTHROPIC_API_KEY=

# --- Postgres / pgvector (matches docker-compose.yml defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

# --- Models, all routed through LiteLLM (provider/model-name format) ---
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
GENERATION_MODEL=openai/gpt-4o-mini
# Judge model for evaluate.py. Can be set to a different model than
# GENERATION_MODEL to reduce "LLM grading its own output" bias.
EVAL_JUDGE_MODEL=openai/gpt-4o-mini

# --- Reranking (stage 4) ---
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval (stage 3) ---
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
